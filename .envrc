# NOTE!  you must run `direnv allow` to enable this file
#
# Loads .env (non-secret defaults: TF_ACC, BEM_BASE_URL) then .envrc.local,
# which pulls BEM_API_KEY out of 1Password. Neither .env nor .env.local is
# tracked in git - see .env.example for what to put in them.
#
# Acceptance tests (TF_ACC=1) create and destroy REAL functions and workflows
# in whatever environment BEM_BASE_URL points at. testAccPreCheck refuses to
# run against production (api.bem.ai), but keep BEM_BASE_URL on staging.

dotenv_if_exists

# Source personal/local overrides if they exist (not tracked in git)
source_env_if_exists .envrc.local
