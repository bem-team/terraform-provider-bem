## Template for local development env files. Copy, don't edit in place:
##
##   cp .env.example .env          # then strip the secret block below
##   cp .env.example .env.local    # then keep only the secret block
##
## Both .env and .env.local are gitignored, as is .envrc.local. Only .envrc and
## this file are tracked. Requires direnv (`direnv allow`) and the 1Password CLI
## (`op`).

## --- .env : non-secret defaults -------------------------------------------

# Enable Terraform acceptance tests. Without this, every TestAcc* test skips.
# With it set, a plain `go test ./...` runs them too - they create and destroy
# real resources against BEM_BASE_URL. For a fast unit-only run:
#   TF_ACC= go test ./... -race -count=1
TF_ACC=1

# API host the provider and the acceptance tests talk to. MUST be staging:
# testAccPreCheck hard-fails on api.bem.ai, and refuses to run at all if this
# is unset (unset would otherwise silently default to production).
BEM_BASE_URL=https://api.stg.us1.bem.ai

## --- .env.local : 1Password references, never literal secrets --------------
##
## The commented lines below are 1Password secret references, resolved by
## `op inject` in .envrc.local. Never paste a real key there - the file is
## gitignored, but a resolved secret on disk is one `cat` away from a terminal
## transcript or a pasted ticket.
##
## Careful when editing .env.local: `op inject` scans the whole file for secret
## references, comments included. Writing the "op" scheme prefix in prose makes
## it try to resolve that prose as a reference and fail the entire file.
#
# export BEM_STG_US1_API_KEY="op://IaC/terraform-cli/BEM_STG_US1_API_KEY"
# export BEM_API_KEY=$BEM_STG_US1_API_KEY
